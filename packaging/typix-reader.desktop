[Desktop Entry]
Type=Application
Version=1.0
Name=TypixDeck 阅读器
Comment=Local ebooks, PDF pages, Kindle and Calibre OPDS reader
Exec=/usr/bin/typix-reader %f
Icon=accessories-text-editor
Terminal=false
Categories=Office;Viewer;
StartupNotify=true
MimeType=text/plain;text/markdown;application/epub+zip;application/vnd.comicbook+zip;application/pdf;application/x-mobipocket-ebook;application/vnd.amazon.ebook;application/x-mobi8-ebook;
X-TypixDeck-LaunchMode=supervised
X-TypixDeck-Fullscreen=true
X-TypixDeck-FullscreenAppId=ai.typixdeck.reader
